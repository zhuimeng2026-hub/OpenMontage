{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmontage.local/schemas/remix/remix-package-v2.schema.json",
  "title": "OpenMontage RemixPackage v2",
  "description": "v2 RemixPackage schema for VClaw + OpenMontage repair plan (T01, 2026-09-05). Implements C1-C9 from B:/docs/vclaw-om-remix-repair-plan-2026-09-05/01-contracts.md. Times in INTEGER milliseconds. Frame conversions derived from fps using output_frame(t_ms) = floor(t_ms * fps / 1000 + 0.5).",
  "type": "object",
  "required": ["schema_version", "project_id", "processing_mode", "timeline", "audio", "render", "review"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 2},
    "project_id": {"type": "string", "minLength": 1, "pattern": "^[a-zA-Z0-9_-]+$"},
    "processing_mode": {"enum": ["direct", "openclaw_assisted"]},
    "source_asset_id": {"type": ["string", "null"], "description": "null allowed for draft without source"},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "file_key", "media_type"],
        "additionalProperties": false,
        "properties": {
          "asset_id": {"type": "string", "minLength": 1},
          "file_key": {"type": "string", "minLength": 1, "description": "server-relative POSIX path; not URL, not local Windows path"},
          "media_type": {"enum": ["video", "image", "audio"]}
        }
      }
    },
    "timeline": {
      "type": "object",
      "required": ["fps", "duration_ms", "width", "height", "scenes"],
      "additionalProperties": false,
      "properties": {
        "fps": {"type": "integer", "enum": [30], "description": "first version fixed at 30"},
        "duration_ms": {"type": "integer", "minimum": 1, "maximum": 600000, "description": "C3: max 600,000 ms"},
        "width": {"enum": [1080, 1920]},
        "height": {"enum": [1080, 1920]},
        "scenes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {"$ref": "#/$defs/scene"}
        }
      }
    },
    "audio": {
      "type": "object",
      "required": ["mode", "narration_asset_id", "volume"],
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["source", "mute", "tts"]},
        "narration_asset_id": {"type": ["string", "null"]},
        "volume": {"type": "number", "minimum": 0, "maximum": 1, "default": 1}
      }
    },
    "subtitles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "start_ms", "end_ms", "text"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "start_ms": {"type": "integer", "minimum": 0},
          "end_ms": {"type": "integer", "minimum": 1},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "render": {
      "type": "object",
      "required": ["runtime", "renderer_family", "publish"],
      "additionalProperties": false,
      "properties": {
        "runtime": {"enum": ["remotion"]},
        "renderer_family": {"enum": ["reference-remix"]},
        "publish": {"type": "boolean"}
      }
    },
    "review": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["draft", "confirmed"]},
        "confirmed_scene_ids": {"type": "array", "items": {"type": "string"}},
        "audio_confirmed": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "scene": {
      "type": "object",
      "required": ["scene_id", "mode", "asset_id", "start_ms", "end_ms", "source_start_ms", "source_end_ms", "fit", "transition_in"],
      "additionalProperties": false,
      "properties": {
        "scene_id": {"type": "string", "minLength": 1, "pattern": "^[a-zA-Z0-9_-]+$"},
        "mode": {"enum": ["keep", "replace", "generate"]},
        "asset_id": {"type": ["string", "null"], "description": "null allowed only when review.status=draft and pending_reason set"},
        "pending_reason": {"type": "string", "description": "draft-only field; required when asset_id is null in draft"},
        "start_ms": {"type": "integer", "minimum": 0},
        "end_ms": {"type": "integer", "minimum": 1},
        "source_start_ms": {"type": "integer", "minimum": 0},
        "source_end_ms": {"type": "integer", "minimum": 1},
        "fit": {"enum": ["contain", "cover"]},
        "transition_in": {
          "type": "object",
          "required": ["type", "duration_ms"],
          "additionalProperties": false,
          "properties": {
            "type": {"enum": ["cut", "fade"], "description": "first version supports only explicit cut/fade"},
            "duration_ms": {"type": "integer", "minimum": 0, "maximum": 5000}
          }
        }
      }
    }
  }
}