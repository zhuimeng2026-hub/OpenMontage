# OpenMontage 监控环境变量样例（Linux systemd EnvironmentFile）
# 复制为 /etc/openmontage/monitor.env 并填入真实值。权限务必 600，属主 openmontage。

# MCP / 上游 Bearer token（优先级高于 OM_MCP_TOKEN）
OM_MCP_TOKEN=REPLACE_WITH_REAL_TOKEN

# 上游链路探测目标（渲染机指向 BFF，BFF 机指向上游 MCP）
# OM_PROBE_TARGET=http://bff-host:8080/api/mcp
OM_PROBE_TARGET=http://localhost:8900/mcp

# 监控角色：all | bff | render
OM_PROBE_ROLE=all

# 暴露端口
OM_PROBE_PORT=9099

# 可选：om_mcp_probe 自身的若干默认端点（一般无需改）
# OM_MCP_URL=http://localhost:8900/mcp
