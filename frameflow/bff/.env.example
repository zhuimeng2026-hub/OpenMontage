# FrameFlow BFF 配置模板 —— 复制为 .env 后填写真实值
# 注意：所有带 secret 的字段都只存在于服务端，绝不下发到浏览器。

# —— Remotion MCP（dw.aixifs.com）——
MCP_BASE_URL=https://dw.aixifs.com/mcp
MCP_API_TOKEN=                # 必填：Bearer token，对应 OpenMontage 的 MCP_API_TOKEN
MCP_PROGRESS_URL=https://dw.aixifs.com/render-progress

# —— 微信服务号（公众号）网页授权 ——
# 注意：值为空的行不要写行尾 # 注释（godotenv 会把 # 之后当作值），注释请写在单独一行。
WECHAT_APP_ID=
# 服务端专用，切勿暴露
WECHAT_APP_SECRET=
# 可留空，默认用本 BFF 的 /api/wechat/callback
WECHAT_REDIRECT_URI=
WECHAT_SCOPE=snsapi_userinfo

# —— BFF 自身 ——
BFF_PORT=8080
FRONTEND_ORIGIN=              # 仅当 SPA 与 BFF 不同源时才需要，例如 http://localhost:5173
SESSION_SECURE=false          # 生产 HTTPS 环境设 true
STATIC_DIR=./web              # 放 index.html / config.js / mcp-client.js 的目录
STATE_DB_PATH=./data/frameflow.db

# —— 安全（上线前把 AUTH_REQUIRED 改为 true，并先填好微信参数）——
AUTH_REQUIRED=false           # true 时 /api/mcp 与 /api/render-progress 需已登录会话，否则 401
RATE_LIMIT_PER_MIN=30         # 每会话/IP 每分钟令牌桶容量，超额返回 429
IMAGE_BATCH_MAX_PARALLEL=2    # 单机图片批次同时渲染数；0 表示不限制
IMAGE_BATCH_MAX_PER_USER=2    # 单个会话同时渲染数；0 表示不限制
IMAGE_BATCH_LEASE_TTL_MIN=30  # SQLite 限流租约过期时间（分钟），异常退出后自动释放

# —— 自定义合成（脚本模式编辑器）——
# 上游 dw.aixifs.com/mcp 的 create_remotion_video_share 目前【不接受】自定义
# 合成代码，故默认关闭：编辑器可保存/管理合成，但「渲染此合成」会返回 501 明确提示。
# 待上游增加 code 入参后，改为 true 即可点亮真实渲染。
CUSTOM_COMPOSITION_ENABLED=false

# —— 业务取图（批量渲染的 Fetcher）——
# 默认 StubFetcher 从下面这个 JSON 读取「业务场景 key -> 图片列表」的静态映射，
# 用于在没有真实业务系统接入时联调上传/渲染流程。格式：
# {"场景A":[{"url":"https://.../1.jpg","name":"1.jpg"},{"url":"https://.../2.jpg","name":"2.jpg"}]}
# 真实接入时，实现 business.Fetcher 接口替换 StubFetcher 即可，无需改批量逻辑。
BUSINESS_STUB_IMAGES=

# —— 业务取图：腾讯微云官方 MCP（可选，优先级高于 StubFetcher）——
# 填了 WEIYUN_API_KEY 即走微云官方 MCP 取图（每个场景 = 一个微云目录，
# businessKey 即该目录的 dir_key）。不填则退回上面的 StubFetcher。
# 鉴权：请求头 WyHeader: mcp_token=<WEIYUN_API_KEY>（由 BFF 自动加）。
WEIYUN_API_KEY=
WEIYUN_MCP_URL=https://www.weiyun.com/api/v3/mcpserver

# —— 用户分级配额（批量渲染）——
# 一个「渲染任务」= 一次 batch-render 提交（一个 job，可含多个场景）。
# DEFAULT_TIER 作用于所有用户，目前内置档位：
#   free : 单次最多 10 个图片文件 / 每天 10 个渲染任务 / 同时 10 个任务
#   pro  : 单次最多 100 个文件   / 每天 200 个任务    / 同时 50 个任务
# 未来更高等级（如 enterprise）只需在 internal/limits 的 Registry 加一行。
# TIER_OVERRIDES 为可选 JSON：把特定用户(ff_sid) 映射到更高档位，用于灰度/早鸟，
# 例如：{"a1b2c3...":"pro"}。接入真实用户库/微信后可换成按账号解析，无需改逻辑。
DEFAULT_TIER=free
TIER_OVERRIDES=
