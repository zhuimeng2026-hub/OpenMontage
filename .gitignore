# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Local model downloads (e.g. Piper TTS voices, fetched at runtime — not source)
*.onnx
*.onnx.json

# Large media files (rendered outputs, downloaded source videos — regenerable)
*.mp4
*.wav
*.mp3
*.m4a

# Test/IDE
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.trae/
.idea/
.vscode/

# Pipeline outputs (regenerable — never commit large media)
output/
pipeline/
tests/qa/output/

# Project workspaces (generated assets, renders — all regenerable).
# This rule covers both real production trees (projects/<id>/) and the
# throwaway scratch zone (projects/_scratch/) — see projects/_scratch/README.md
# for when each is the right home for tool output.
projects/

# Stray audio/video at the repo root (defense in depth — every output should
# land in projects/_scratch/<category>/ or projects/<id>/assets/, never here).
# Patterns are anchored to the repo root via the leading slash.
/*.wav
/*.mp4
/*.mov

# Corpus directories (downloaded stock clips, thumbnails, embeddings —
# regenerable from source APIs via corpus_builder). Explicit rule even
# though most corpora live under projects/ since agents sometimes
# build scratch corpora at the repo root.
corpus/
**/corpus/

# User music library (personal royalty-free tracks — not part of repo)
music_library/

# Environment & credentials
.env
.env.local
*.env
.youtube-token.json
# Google service-account / Vertex AI keys — never commit
gcp-*.json
*-service-account.json
service-account*.json
service_account*.json

# Stray media downloads (test/scratch clips left in repo root)
pexels_video_*.mp4

# Scratch/debug scripts
scratch/

# Internal docs (strategy, handoffs, playbooks — not shipped)
internal/

# Local agent config (user-specific)
.claude/memory/
.claude/settings.local.json
.workbuddy/

# Agent skills lock (local install tracking)
skills-lock.json

# Local e2e validation scripts / logs / scratch assets (dev-only, regenerable)
local_run/
om_mcp_probe.log

# Generated images (logo drafts — final logo lives in assets/)
logo_*.png
generated_image.png

# Downloaded music files (Pixabay, Freesound — not source code)
pixabay_music_*

# OS
.DS_Store
Thumbs.db

# Node (for remotion-composer/)
node_modules/

# Remotion build output and copied project assets (regenerable at render time)
remotion-composer/out/
# Project-local bespoke ("atelier") compositions — hand-authored per video,
# throwaway and regenerable. Keeps the shared src/ free of one-off scenes.
remotion-composer/projects/
remotion-composer/public/*
# But keep demo props (shipped with the project for zero-key demos)
!remotion-composer/public/demo-props/
# Ignore test/scratch compositions in demo-props (keep only curated demos)
remotion-composer/public/demo-props/test-*
remotion-composer/public/demo-props/talking-head-*
remotion-composer/public/demo-props/caption-burn-*

venv/
.venv/

# Backlot local cache (thumbnails)
.backlot/

# OpenMontage MCP proxy build artifact & local log (regenerable / runtime).
# Cover all binaries the proxy build emits regardless of prefix, plus any
# *.bak.* timestamped backups and any test/locator env files.
OpenMontage-mcp-proxy/openmontage-mcp-proxy*
OpenMontage-mcp-proxy/mcp-proxy*
OpenMontage-mcp-proxy/*.bak.*
OpenMontage-mcp-proxy/proxy.log
OpenMontage-mcp-proxy/*.log
OpenMontage-mcp-proxy/.env.test
OpenMontage-mcp-proxy/.env.local
/openmontage-mcp-proxy*
/proxy.log
logs/

# FrameFlow BFF compiled binary (go build output)
frameflow/bff/frameflow-bff

# WeChat 域名校验文件（部署产物，与具体域名绑定，不入库）
MP_verify_*.txt

# Runtime artifacts (dev logs, caches, binaries, temp uploads) — regenerable
.bff-mcp.err.log
.bff-mcp.out.log
.ff_loop*.log
.om_mcp.log
.ff_test.png
.tmp-upload-*/
.remote-*.log
.remote-*.db
.remote-*.db-shm
.remote-*.db-wal
# Local runtime databases (frameflow) — regenerable, never commit
data/*.db
data/*.db-shm
data/*.db-wal
.gocache-browser/
.gocache-log/
.gocache-test/
frameflow/bff/.bff-bin/
frameflow/bff/data/
# Local build / run artifacts (frameflow BFF) — regenerable, never commit
frameflow/bff/bff-server.exe
frameflow/bff/*.exe~
frameflow/bff/bff.log
p1_run.txt
result_run.txt
pexels_6684209.jpg
test_*.srt
test_*.vtt
test_*.caption.json

# nginx runtime logs / generated tool lists (regenerable)
nginx/direct_mcp.log
nginx/e2e_browser.log
nginx/e2e_render.log
nginx/_tools_list.json

# TLS private keys & certs (deployment secrets — never commit)
nginx/ssl/

remotion-composer/build.env.test
.gstack/
# Runtime logs (regenerable from server runs)
mcp_server.log
frameflow/bff/bff.log.new
